@startuml
!theme plain
skinparam activity {
  BorderColor #4285F4
  BackgroundColor #E8F0FE
  FontColor #3C4043
  FontSize 14
  ArrowColor #4285F4
}
skinparam note {
  BackgroundColor #FFF7DA
  BorderColor #FBBC04
}
skinparam partition {
  BorderColor #34A853
  BackgroundColor transparent
  FontColor #34A853
  FontSize 16
}

title GOFAI Architecture: k8s-to-puml

start
:Execute `M-x k8s-to-puml`\nin a yaml-ts-mode buffer;

partition "1. Extraction Engine" {
  :Retrieve AST Root (Tree-sitter);
  :Initialize Facts List;
  repeat :For each YAML Document;
    :Extract Basic Metadata\n(kind, name, namespace);
    if (Rule in `extraction-rules`?) then (Yes)
      :Extract specific data\n(selectors, volumes, refs);
    endif
    :Append Fact to List;
  repeat while (More documents?)
}

partition "2. Inference Engine (Facts)" {
  :Evaluate `inference-rules`;
  note right: Infers Internet, Ingress Controller\nand External Storage (Dummy Facts)
  :Inject inferred facts into the list;
}

partition "3. Transformation Engine" {
  :Group RoleBindings and Roles;
  note right: Merges into "RoleGroup"\nfor unified rendering
}

partition "4. Rendering Engine (Shapes)" {
  :Group Facts by Namespace;
  :Inject Infrastructure Wrapper (if configured);
  repeat :For each Fact;
    if (Kind is Blacklisted?) then (Yes)
      :Render Commented Shape (');
    else (No)
      :Render Standard Shape;
    endif
  repeat while (More facts?)
}

partition "5. Relation Engine (GOFAI)" {
  :Cartesian Product (Fact A x Fact B);
  repeat :For each pair (A, B);
    if (Rule in `relation-rules` matches?) then (Yes)
      if (A or B is Blacklisted?) then (Yes)
        :Generate Commented Connection (');
      else (No)
        :Generate Connection;
      endif
    endif
  repeat while (More pairs?)
}

partition "6. Finalization" {
  :Inject Custom Network Relations;
  :Display `*k8s-to-puml-draft-diagram*` buffer;
}

stop
@enduml
